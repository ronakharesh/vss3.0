# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Required ---

# Your NGC CLI API key (same one used in scripts/dev-profile.sh)
NGC_CLI_API_KEY=nvapi-CHANGE_ME

# Container registry where custom-built images will be pushed.
#
# EASIEST (single machine): use a local Docker registry on localhost:5000
#   Step 1: docker run -d -p 5000:5000 --restart=always --name local-registry registry:2
#   Step 2: set YOUR_REGISTRY=localhost:5000
#   k3s on the same machine can pull from localhost:5000 without any TLS config.
#   (If using --install-k3s mode, the local registry is started automatically.)
#
# REMOTE REGISTRY (deploy to multiple machines):
#   docker.io/youruser          Docker Hub — images are public by default
#   ghcr.io/yourorg             GitHub Container Registry
#   us-docker.pkg.dev/proj/repo GCP Artifact Registry
YOUR_REGISTRY=localhost:5000

# IP address of the Kubernetes node (for NodePort access and Kibana URL)
# On this machine: 172.19.4.52
NODE_IP=CHANGE_ME

# --- Optional (defaults shown) ---

NAMESPACE=vss-alerts

# GPU device IDs — must match what nvidia-smi reports
# IMPORTANT: DeepStream (RT_CV) cannot share a GPU with an active CUDA MPS server.
# If GPU 0 already has processes on it (check: nvidia-smi), use a different GPU for RT_CV.
# On this machine GPU 3 is confirmed clean; GPUs 1 and 2 are used by the NIM models.
RT_CV_DEVICE_ID=3    # DeepStream perception (avoid GPU 0 if MPS is running there)
LLM_DEVICE_ID=1      # nvidia-nemotron-nano-9b-v2
VLM_DEVICE_ID=2      # cosmos-reason2-8b

# Number of video streams to process (default 1)
NUM_SENSORS=1
