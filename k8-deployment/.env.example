# ============================================================
# VSS Alert Verification — Environment Configuration
#
# Copy to .env and fill in the two required values:
#   cp .env.example .env
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────

# Your NGC API key — used to pull NIM images and download models
# Get one at: https://org.ngc.nvidia.com/setup/api-key
NGC_CLI_API_KEY=nvapi-CHANGE_ME

# IP address of this machine (used for service URLs and Kibana config)
NODE_IP=CHANGE_ME

# ── OPTIONAL — defaults are set automatically ───────────────

# Container registry for custom-built images.
# Default: localhost:5000 — the script starts a local registry automatically.
# Override only if you want to use an external registry (Docker Hub, GHCR, etc.)
# YOUR_REGISTRY=localhost:5000

# Kubernetes namespace (default: vss-alerts)
# NAMESPACE=vss-alerts

# GPU device IDs — change to match your machine's GPU layout
# Run `nvidia-smi` to see available GPUs.
# DeepStream (RT_CV) CANNOT share a GPU with a CUDA MPS server.
# Check for MPS: ps aux | grep nvidia-cuda-mps
# RT_CV_DEVICE_ID=3    # DeepStream perception
# LLM_DEVICE_ID=1      # nvidia-nemotron-nano-9b-v2 (hint only — TP=2 uses 2 GPUs)
# VLM_DEVICE_ID=2      # cosmos-reason2-8b

# Number of concurrent RTSP camera streams
# NUM_SENSORS=1
